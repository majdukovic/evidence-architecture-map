    {
      "id": "email-service",
      "label": "E-mail outbox",
      "short": "Scheduler + sender loop",
      "layer": "services",
      "repo": "bootzooka",
      "purpose": "Other modules only insert an e-mail row; a background loop started at startup sends rows in batches and then deletes them. A second loop reports the queue size as a metric.",
      "callout": "A batch is sent in full and only then deleted. If the sender throws part-way, nothing in the batch is deleted, the loop logs the error, and the rows stay in the outbox and are read again in a later round, so e-mails already sent earlier in that batch are sent again.",
      "stores": [
        "PostgreSQL: scheduled_emails"
      ],
      "evidence": [
        {
          "ref": "bootzooka:backend/src/main/scala/com/softwaremill/bootzooka/email/EmailService.scala:27",
