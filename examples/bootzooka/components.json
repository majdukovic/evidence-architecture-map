    {
      "id": "password-reset",
      "label": "Password reset module",
      "short": "Forgot / reset",
      "layer": "services",
      "repo": "bootzooka",
      "purpose": "Creates a one-time reset code for a user and schedules an e-mail carrying a link with it; a second endpoint exchanges a valid code and a new password for a password change.",
      "callout": "Resetting a password only writes the new hash: the new password is not validated (unlike registration and change-password) and the user's existing API keys stay valid (change-password deletes them all).",
      "exposes": [
        "POST /passwordreset/forgot",
        "POST /passwordreset/reset"
      ],
      "stores": [
        "PostgreSQL: password_reset_codes"
      ],
      "evidence": [
