    {
      "id": "otel",
      "label": "OpenTelemetry",
      "short": "Traces, metrics, logs",
      "layer": "services",
      "repo": "bootzooka",
      "purpose": "At startup the backend creates an OpenTelemetry SDK configured from <code>OTEL_*</code> environment variables, adds JVM runtime metrics and installs the Logback appender that sends logs through it. The HTTP server gets Tapir tracing and metrics interceptors, the outgoing HTTP client is wrapped with tracing and metrics, and a <code>Metrics</code> class defines two custom instruments: a counter bumped on each registration request and an e-mail queue gauge.",
      "callout": "The SDK is created in <code>Dependencies.create</code>; where the data goes is decided by <code>OTEL_*</code> environment variables or <code>otel.*</code> system properties (docker-compose sets an OTLP endpoint, <code>backend-start.sh</code> sets <code>OTEL_SDK_DISABLED=true</code>).",
      "exposes": [
        "Metric: bootzooka_registered_users_counter",
        "Metric: bootzooka_email_queue_gauge"
      ],
      "evidence": [
        {
          "ref": "bootzooka:backend/src/main/scala/com/softwaremill/bootzooka/Dependencies.scala:68",
          "quote": "AutoConfiguredOpenTelemetrySdk"
        },
        {
          "ref": "bootzooka:backend/src/main/scala/com/softwaremill/bootzooka/Dependencies.scala:71",
          "quote": "RuntimeMetrics.create(otel).discard"
        },
        {
          "ref": "bootzooka:backend/src/main/scala/com/softwaremill/bootzooka/Dependencies.scala:72",
          "quote": "OpenTelemetryAppender.install"
        },
        {
          "ref": "bootzooka:backend/src/main/scala/com/softwaremill/bootzooka/http/HttpApi.scala:43",
          "quote": ".prependInterceptor(OpenTelemetryTracing(otel))"
        },
        {
          "ref": "bootzooka:backend/src/main/scala/com/softwaremill/bootzooka/http/HttpApi.scala:48",
          "quote": "OpenTelemetryMetrics.default[Identity](otel)"
        },
        {
          "ref": "bootzooka:backend/src/main/scala/com/softwaremill/bootzooka/Dependencies.scala:42",
          "quote": "OpenTelemetryTracingBackend(HttpClientSyncBackend(), otel)"
        },
        {
          "ref": "bootzooka:backend/src/main/scala/com/softwaremill/bootzooka/metrics/Metrics.scala:11",
          "quote": ".counterBuilder(\"bootzooka_registered_users_counter\")"
        },
        {
          "ref": "bootzooka:backend/src/main/scala/com/softwaremill/bootzooka/metrics/Metrics.scala:17",
