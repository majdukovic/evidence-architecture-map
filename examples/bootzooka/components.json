      "label": "Security (API keys)",
      "short": "Bearer API keys",
      "layer": "services",
      "repo": "bootzooka",
      "purpose": "Authenticates a request by looking its token up in the database and checking its expiry. The same <code>Auth</code> class serves API keys (multi-use, kept) and password reset codes (one-time, deleted when used).",
      "stores": [
        "PostgreSQL: api_keys"
      ],
      "evidence": [
