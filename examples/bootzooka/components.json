      "id": "ui",
      "label": "Web UI (React)",
      "short": "Browser SPA",
      "layer": "people",
      "repo": "bootzooka",
      "purpose": "Single-page React app in <code>ui/</code>. It calls the backend JSON API through a client generated from the OpenAPI description and keeps the API key in the browser's local storage.",
      "exposes": [
        "/",
        "/login",
        "/register",
        "/recover-lost-password",
        "/main",
        "/profile",
        "/* (not found page)"
      ],
      "stores": [
        "localStorage: apiKey"
      ],
      "evidence": [
