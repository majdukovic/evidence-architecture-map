    {
      "id": "security",
      "label": "Security (API keys)",
      "short": "Bearer API keys",
      "layer": "services",
      "repo": "bootzooka",
      "purpose": "Authenticates a request by looking its token up in the database and checking its expiry. The same <code>Auth</code> class serves API keys (multi-use, kept) and password reset codes (one-time, deleted when used).",
      "callout": "<b>Logout</b> deletes the API key sent in the request <i>body</i> (<code>Logout_IN.apiKey</code>), not necessarily the key that authenticated the call. <b>Change password</b> validates the new password and deletes all of the user's API keys, then issues a new one; <b>password reset</b> does neither (see the API key flow).",
      "stores": [
        "PostgreSQL: api_keys"
      ],
      "evidence": [
        {
          "ref": "bootzooka:backend/src/main/scala/com/softwaremill/bootzooka/security/Auth.scala:24",
