          "quote": "http.ListenAndServe(addr+\":\"+srvPort, handler)"
        },
        {
          "ref": "microservices-demo:src/frontend/Dockerfile:44",
          "quote": "ENTRYPOINT [\"/src/server\"]"
        },
        {
          "ref": "microservices-demo:kubernetes-manifests/frontend.yaml:130",
          "quote": "type: LoadBalancer"
        },
        {
          "ref": "microservices-demo:src/frontend/main.go:44",
          "quote": "cookieSessionID = cookiePrefix + \"session-id\""
        }
      ]
    },
