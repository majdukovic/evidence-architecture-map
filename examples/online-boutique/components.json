      "id": "frontend",
      "label": "Frontend",
      "short": "Web shop (Go BFF)",
      "layer": "entry",
      "repo": "microservices-demo",
      "gateway": true,
      "purpose": "Go web server that renders the shop's HTML pages. Every page handler calls the backend services over gRPC and stitches the results together; it also proxies the chat box to the <b>Shopping assistant</b> over HTTP.",
      "callout": "The shopper's identity is just a random UUID in the <code>shop_session-id</code> cookie; it is passed to backends as <code>user_id</code>.",
      "exposes": [
        "GET /",
        "GET /product/{id}",
        "GET /cart",
        "POST /cart",
        "POST /cart/empty",
        "POST /setCurrency",
        "POST /cart/checkout",
        "GET /assistant",
        "POST /bot",
        "GET /product-meta/{ids}",
        "GET /logout",
        "GET /_healthz"
      ],
      "stores": [
        "Cookie: shop_session-id",
        "Cookie: shop_currency"
      ],
      "evidence": [
        {
          "ref": "microservices-demo:src/frontend/main.go:150",
          "quote": "r.HandleFunc(baseUrl+\"/\", svc.homeHandler)"
        },
        {
