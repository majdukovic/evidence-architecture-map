    "tests": [
      {
        "name": "AddItem_New_Inserted",
        "why": "Calls cartservice AddItem over gRPC on an in-process test server with no REDIS_ADDR set, so Startup uses the in-memory cache, not Redis; covers only the cart part of this flow",
