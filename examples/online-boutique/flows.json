  {
    "id": "place-order",
    "title": "Place an order",
    "tagline": "Checkout form to order confirmation page",
    "featured": true,
    "summary": "What happens when a shopper (or the load generator) submits the checkout form. The frontend validates the form and calls <b>Checkout</b>, which reads the cart, prices items and shipping in the shopper's currency, charges the card (a fake charge), ships (a fake shipment), empties the cart and asks for a confirmation email (only logged). Cart, pricing, payment and shipping failures abort the order; emptying the cart and the email are best effort.",
    "actors": [
      "loadgenerator",
      "frontend",
      "checkoutservice",
      "cartservice",
      "productcatalogservice",
      "currencyservice",
      "shippingservice",
      "paymentservice",
      "emailservice",
      "recommendationservice"
    ],
    "steps": [
      {
        "from": "loadgenerator",
        "to": "frontend",
        "kind": "req",
        "label": "Submit the checkout form",
        "protocol": "HTTP",
        "call": {
          "verb": "POST",
          "target": "/cart/checkout"
        },
        "request": {
          "email": "jo@example.com",
          "street_address": "1 Main St",
          "zip_code": "94043",
          "city": "Mountain View",
          "state": "CA",
          "country": "United States",
          "credit_card_number": "4111111111111111",
          "credit_card_expiration_month": "1",
          "credit_card_expiration_year": "2030",
          "credit_card_cvv": "123"
        },
        "requestSchema": {
          "ref": "microservices-demo:src/frontend/validator/validator.go:42",
          "quote": "type PlaceOrderPayload struct {"
        },
        "description": "A form post (not JSON). The load generator sends the same fields a browser does. The frontend parses them and validates them (required fields, email format, card number format, month 1 to 12); a validation error returns HTTP 422 and checkout is never called.",
        "evidence": [
          {
            "ref": "microservices-demo:src/loadgenerator/locustfile.py:61",
            "quote": "l.client.post(\"/cart/checkout\", {"
          },
          {
            "ref": "microservices-demo:src/frontend/handlers.go:325",
            "quote": "email         = r.FormValue(\"email\")"
          },
          {
            "ref": "microservices-demo:src/frontend/handlers.go:350",
            "quote": "http.StatusUnprocessableEntity"
          }
        ]
      },
      {
        "from": "frontend",
        "to": "checkoutservice",
        "kind": "req",
        "label": "PlaceOrder",
        "protocol": "gRPC",
        "call": {
          "verb": "rpc",
          "target": "hipstershop.CheckoutService/PlaceOrder"
        },
        "request": {
          "user_id": "<session id>",
          "user_currency": "EUR",
          "address": {
            "street_address": "1 Main St",
            "city": "Mountain View",
            "state": "CA",
            "country": "United States",
            "zip_code": 94043
          },
          "email": "jo@example.com",
          "credit_card": {
            "credit_card_number": "4111111111111111",
            "credit_card_cvv": 123,
