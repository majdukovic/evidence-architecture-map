        "kind": "res",
        "label": "Empty",
        "protocol": "gRPC",
        "noPayload": true,
        "responseSchema": {
          "ref": "microservices-demo:src/cartservice/src/protos/Cart.proto:50",
          "quote": "message Empty {}"
        },
        "description": "A storage error comes back as gRPC FailedPrecondition.",
        "evidence": [
          {
            "ref": "microservices-demo:src/cartservice/src/services/CartService.cs:37",
