  {
    "id": "add-to-cart",
    "title": "Add an item to the cart",
    "tagline": "Product page to Redis",
    "featured": true,
    "summary": "The shopper picks a quantity on a product page and presses <b>Add to cart</b>. The browser posts a form to the frontend, which checks the product exists, asks the cart service to add it, and redirects to <code>/cart</code>. Default store: <b>redis-cart</b>.",
    "actors": [
      "frontend",
      "productcatalogservice",
      "cartservice",
      "redis-cart"
    ],
    "steps": [
      {
        "from": "frontend",
        "to": "frontend",
        "kind": "self",
        "label": "Receive the add-to-cart form",
        "protocol": "HTTP",
        "call": {
          "verb": "POST",
          "target": "/cart"
        },
        "request": {
          "product_id": "OLJCESPC7Z",
          "quantity": "2"
        },
        "description": "The product page form posts <code>product_id</code> and <code>quantity</code>. The frontend validates quantity 1 to 10 (else 422) and takes the shopper id from the <code>shop_session-id</code> cookie.",
        "evidence": [
          {
            "ref": "microservices-demo:src/frontend/main.go:153",
            "quote": "r.HandleFunc(baseUrl+\"/cart\", svc.addToCartHandler)"
          },
          {
            "ref": "microservices-demo:src/frontend/handlers.go:214",
            "quote": "productID := r.FormValue(\"product_id\")"
          },
          {
            "ref": "microservices-demo:src/frontend/validator/validator.go:38",
            "quote": "validate:\"required,gte=1,lte=10\""
          },
          {
            "ref": "microservices-demo:src/frontend/templates/product.html:57",
            "quote": "name=\"product_id\""
          }
        ]
      },
      {
        "from": "frontend",
        "to": "productcatalogservice",
        "kind": "req",
        "label": "Check the product exists",
        "protocol": "gRPC",
        "call": {
          "verb": "rpc",
          "target": "ProductCatalogService/GetProduct"
        },
        "request": {
          "id": "OLJCESPC7Z"
        },
        "requestSchema": {
          "ref": "microservices-demo:protos/demo.proto:93",
          "quote": "message GetProductRequest {"
        },
        "evidence": [
          {
            "ref": "microservices-demo:src/frontend/handlers.go:225",
            "quote": "fe.getProduct(r.Context(), payload.ProductID)"
          },
          {
            "ref": "microservices-demo:src/frontend/rpc.go:53",
            "quote": "GetProduct(ctx, &pb.GetProductRequest{Id: id})"
          }
        ]
      },
      {
        "from": "productcatalogservice",
        "to": "frontend",
        "kind": "res",
        "label": "Product (or NotFound)",
        "protocol": "gRPC",
        "response": {
          "id": "OLJCESPC7Z",
          "name": "Sunglasses",
          "description": "Aviator sunglasses",
          "picture": "/static/img/products/sunglasses.jpg",
          "price_usd": {
            "currency_code": "USD",
            "units": 19,
            "nanos": 990000000
          },
          "categories": [
            "accessories"
          ]
        },
        "responseSchema": {
          "ref": "microservices-demo:protos/demo.proto:77",
          "quote": "message Product {"
        },
        "description": "An unknown id returns gRPC NotFound, which the frontend turns into a 500 page.",
        "evidence": [
          {
            "ref": "microservices-demo:src/productcatalogservice/product_catalog.go:52",
            "quote": "if req.Id == product.Id {"
          },
          {
            "ref": "microservices-demo:src/productcatalogservice/product_catalog.go:57",
            "quote": "codes.NotFound, \"no product with ID %s\""
          }
        ]
      },
      {
        "from": "frontend",
        "to": "cartservice",
        "kind": "req",
        "label": "AddItem",
        "protocol": "gRPC",
        "call": {
          "verb": "rpc",
          "target": "CartService/AddItem"
        },
        "request": {
          "user_id": "3f1c9a2e-7b4d-4e1a-9c0f-2d5e8b6a1f00",
          "item": {
            "product_id": "OLJCESPC7Z",
            "quantity": 2
          }
        },
        "requestSchema": {
          "ref": "microservices-demo:src/cartservice/src/protos/Cart.proto:32",
          "quote": "message AddItemRequest {"
        },
        "description": "<code>user_id</code> is the session cookie value. Cart service compiles its own <code>Cart.proto</code> (same messages as <code>protos/demo.proto</code>).",
        "evidence": [
          {
            "ref": "microservices-demo:src/frontend/handlers.go:231",
            "quote": "fe.insertCart(r.Context(), sessionID(r), p.GetId(), int32(payload.Quantity))"
          },
          {
            "ref": "microservices-demo:src/frontend/rpc.go:68",
            "quote": "AddItem(ctx, &pb.AddItemRequest{"
          },
          {
            "ref": "microservices-demo:src/cartservice/src/services/CartService.cs:36",
            "quote": "_cartStore.AddItemAsync(request.UserId, request.Item.ProductId, request.Item.Quantity)"
          }
        ]
      },
      {
        "from": "cartservice",
        "to": "redis-cart",
        "kind": "req",
        "label": "Read, update, write the cart",
        "protocol": "Redis",
        "payloadNote": "internal",
        "requestSchema": {
          "ref": "microservices-demo:src/cartservice/src/protos/Cart.proto:45",
          "quote": "message Cart {"
        },
        "description": "Reads the cart bytes stored under the user id, adds the item or increases its quantity, and writes the whole <code>Cart</code> protobuf back.",
        "evidence": [
          {
            "ref": "microservices-demo:src/cartservice/src/cartstore/RedisCartStore.cs:40",
