[
  {
    "id": "browse-home",
    "title": "Load the home page",
    "tagline": "Products in your currency",
    "featured": true,
    "summary": "What the frontend's home handler calls, in order: currencies, product list, the shopper's cart (for the cart badge), one currency conversion <b>per product</b>, then an ad. It does <b>not</b> call the recommendation service.",
    "actors": [
      "frontend",
      "currencyservice",
      "productcatalogservice",
      "cartservice",
      "redis-cart",
      "adservice"
    ],
    "steps": [
      {
        "from": "frontend",
        "to": "frontend",
        "kind": "self",
        "label": "GET / and ensure a session id",
        "protocol": "HTTP",
        "call": {
          "verb": "GET",
          "target": "/"
        },
        "noPayload": true,
        "description": "Middleware sets a new random UUID in the <code>shop_session-id</code> cookie if the browser has none (or a fixed shared id when <code>ENABLE_SINGLE_SHARED_SESSION=true</code>, so every new browser shares one cart). The currency comes from the <code>shop_currency</code> cookie (default USD).",
        "evidence": [
          {
            "ref": "microservices-demo:src/frontend/main.go:150",
            "quote": "r.HandleFunc(baseUrl+\"/\", svc.homeHandler)"
          },
          {
            "ref": "microservices-demo:src/frontend/middleware.go:94",
            "quote": "u, _ := uuid.NewRandom()"
          },
          {
            "ref": "microservices-demo:src/frontend/middleware.go:90",
            "quote": "os.Getenv(\"ENABLE_SINGLE_SHARED_SESSION\") == \"true\""
          },
          {
            "ref": "microservices-demo:kustomize/components/single-shared-session/kustomization.yaml:30",
            "quote": "name: ENABLE_SINGLE_SHARED_SESSION"
          },
          {
            "ref": "microservices-demo:src/frontend/handlers.go:574",
            "quote": "c, _ := r.Cookie(cookieCurrency)"
          },
          {
            "ref": "microservices-demo:src/frontend/main.go:40",
            "quote": "defaultCurrency = \"USD\""
          }
        ]
      },
      {
        "from": "frontend",
        "to": "currencyservice",
