          },
          {
            "ref": "microservices-demo:src/cartservice/src/cartstore/RedisCartStore.cs:64",
            "quote": "StatusCode.FailedPrecondition"
          }
        ]
      },
      {
        "from": "frontend",
        "to": "frontend",
        "kind": "self",
        "label": "Redirect to the cart page",
        "protocol": "HTTP",
        "noPayload": true,
        "description": "Responds 302 with <code>location: /cart</code>; the browser then loads the cart page.",
        "evidence": [
          {
            "ref": "microservices-demo:src/frontend/handlers.go:235",
            "quote": "w.Header().Set(\"location\", baseUrl + \"/cart\")"
          },
          {
            "ref": "microservices-demo:src/frontend/handlers.go:236",
            "quote": "w.WriteHeader(http.StatusFound)"
          }
        ]
      }
