  "facts": [
    {"group": "How it runs", "items": [
      {"text": "The gateway has Spring Cloud Gateway routes for vets-service, visits-service, customers-service and genai-service, each using an <code>lb://</code> service-name URI and a path prefix of <code>/api/vet</code>, <code>/api/visit</code>, <code>/api/customer</code> and <code>/api/genai</code>. The routes live in the api-gateway module's own application.yml, not in the config repo's api-gateway.yml.",
        "evidence": [
          {"ref": "spring-petclinic-microservices:spring-petclinic-api-gateway/src/main/resources/application.yml:22", "quote": "uri: lb://vets-service"},
          {"ref": "spring-petclinic-microservices:spring-petclinic-api-gateway/src/main/resources/application.yml:40", "quote": "uri: lb://genai-service"}
        ]},
      {"text": "Every gateway route has a default CircuitBreaker filter that forwards to <code>/fallback</code>, which answers 503.",
        "evidence": [
          {"ref": "spring-petclinic-microservices:spring-petclinic-api-gateway/src/main/resources/application.yml:14", "quote": "fallbackUri: forward:/fallback"},
          {"ref": "spring-petclinic-microservices:spring-petclinic-api-gateway/src/main/java/org/springframework/samples/petclinic/api/boundary/web/FallbackController.java:15", "quote": "HttpStatus.SC_SERVICE_UNAVAILABLE"}
        ]},
      {"text": "The gateway serves the Vue index.html for browser (text/html) navigation that is not under /api, /actuator, /webjars or /fallback.",
        "evidence": [
          {"ref": "spring-petclinic-microservices:spring-petclinic-api-gateway/src/main/java/org/springframework/samples/petclinic/api/ApiGatewayApplication.java:66", "quote": "new ClassPathResource(\"static/index.html\")"},
          {"ref": "spring-petclinic-microservices:spring-petclinic-api-gateway/src/main/java/org/springframework/samples/petclinic/api/ApiGatewayApplication.java:72", "quote": "RequestPredicates.path(\"/api/**\").negate()"}
        ]},
      {"text": "Gateway, customers-service and visits-service read their configuration from the Config server on port 8888 (<code>CONFIG_SERVER_URL</code>, default localhost; <code>config-server</code> host under the docker profile).",
        "evidence": [
          {"ref": "spring-petclinic-microservices:spring-petclinic-api-gateway/src/main/resources/application.yml:5", "quote": "optional:configserver:${CONFIG_SERVER_URL:http://localhost:8888/}"},
          {"ref": "spring-petclinic-microservices:spring-petclinic-customers-service/src/main/resources/application.yml:13", "quote": "configserver:http://config-server:8888"},
          {"ref": "spring-petclinic-microservices:spring-petclinic-visits-service/src/main/resources/application.yml:13", "quote": "configserver:http://config-server:8888"}
        ]},
      {"text": "Under the docker profile the gateway (8080 in the config repo), customers-service (8081) and visits-service (8082) get fixed ports and register with Eureka at discovery-server:8761; by default services use a random port.",
        "evidence": [
          {"ref": "spring-petclinic-microservices-config:api-gateway.yml:5", "quote": "port: 8080"},
          {"ref": "spring-petclinic-microservices-config:customers-service.yml:16", "quote": "port: 8081"},
          {"ref": "spring-petclinic-microservices-config:visits-service.yml:16", "quote": "port: 8082"},
          {"ref": "spring-petclinic-microservices-config:visits-service.yml:20", "quote": "defaultZone: http://discovery-server:8761/eureka/"},
          {"ref": "spring-petclinic-microservices-config:application.yml:5", "quote": "port: 0"}
        ]}
    ]},
    {"group": "Data", "items": [
      {"text": "By default each of customers-service and visits-service uses its own embedded in-memory HSQLDB, initialised from <code>db/hsqldb/schema.sql</code> and <code>data.sql</code>; no JDBC URL is set in the default configuration. The <code>mysql</code> profile in the shared config switches to a MySQL schema and data scripts.",
        "evidence": [
          {"ref": "spring-petclinic-microservices-config:application.yml:13", "quote": "schema-locations: classpath*:db/hsqldb/schema.sql"},
          {"ref": "spring-petclinic-microservices-config:application.yml:14", "quote": "data-locations: classpath*:db/hsqldb/data.sql"},
          {"ref": "spring-petclinic-microservices-config:application.yml:98", "quote": "on-profile: mysql"},
          {"ref": "spring-petclinic-microservices-config:application.yml:105", "quote": "schema-locations: classpath*:db/mysql/schema.sql"}
        ]},
      {"text": "Hibernate does not create tables (<code>ddl-auto: none</code>); schema comes from the SQL scripts.",
        "evidence": [
          {"ref": "spring-petclinic-microservices-config:application.yml:27", "quote": "ddl-auto: none"}
        ]}
    ]}
  ]
