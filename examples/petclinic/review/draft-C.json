  {"ref":"spring-petclinic-microservices:spring-petclinic-genai-service/pom.xml:28","quote":"<!-- artifactId>spring-ai-starter-model-azure-openai"},
  {"ref":"spring-petclinic-microservices:spring-petclinic-genai-service/src/main/resources/application.yml:29","quote":"model: gpt-4o-mini"}]}
],
