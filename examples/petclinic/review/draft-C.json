  {"ref":"spring-petclinic-microservices-config:application.yml:100","quote":"jdbc:mysql://localhost:3306/petclinic"}]},

{"id":"genai-service","label":"GenAI service","short":"Chatbot back end","layer":"services","repo":"spring-petclinic-microservices",
 "purpose":"Spring AI chat back end. Receives chat text, calls the LLM with tools that can list owners, add owners, add pets (calling customers-service) and list vets (similarity search in an in-memory vector store).",
 "callout":"Its vet answers come from a vector store preloaded from <code>vectorstore.json</code>, not from a live call to vets-service. It has no automated tests.",
 "exposes":["POST /chatclient"],"stores":["in-memory SimpleVectorStore, loaded from vectorstore.json"],
 "evidence":[
  {"ref":"spring-petclinic-microservices:spring-petclinic-genai-service/src/main/java/org/springframework/samples/petclinic/genai/PetclinicChatClient.java:57","quote":"@PostMapping(\"/chatclient\")"},
  {"ref":"spring-petclinic-microservices:spring-petclinic-genai-service/src/main/java/org/springframework/samples/petclinic/genai/GenAIServiceApplication.java:25","quote":"@EnableDiscoveryClient"},
  {"ref":"spring-petclinic-microservices:spring-petclinic-genai-service/src/main/resources/application.yml:5","quote":"name: genai-service"},
  {"ref":"spring-petclinic-microservices:spring-petclinic-genai-service/src/main/java/org/springframework/samples/petclinic/genai/AIBeanConfiguration.java:21","quote":"SimpleVectorStore.builder(embeddingModel).build()"}]},

{"id":"llm-provider","label":"LLM provider (OpenAI)","short":"External LLM","layer":"external","repo":"spring-petclinic-microservices",
 "purpose":"Hosted large language model. The pom enables the OpenAI starter (chat model gpt-4o-mini, key from OPENAI_API_KEY). The Azure OpenAI starter is commented out in the pom, although Azure settings remain in application.yml.",
 "callout":"Both OPENAI_API_KEY and AZURE_OPENAI_* are passed to the container by docker-compose.yml, but only the OpenAI starter is on the classpath.",
 "evidence":[
