{"id":"vets-service","label":"Vets service","short":"Veterinarian list","layer":"services","repo":"spring-petclinic-microservices",
 "purpose":"Serves the list of veterinarians and their specialties from its own database. Registers with Eureka and reads its settings from the config server.",
 "callout":"Only one endpoint: <code>GET /vets</code>, cached in a cache named <code>vets</code> when the <code>production</code> profile is active.",
 "exposes":["GET /vets"],"stores":["vets-db (HSQLDB in memory by default; MySQL via profile)"],
