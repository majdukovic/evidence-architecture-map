  {
    "id": "checkout-and-order-status",
    "title": "Check out and follow the order",
    "tagline": "Order creation, stock check, payment, and the events in between",
    "featured": true,
    "summary": "Checkout is one synchronous call to <b>Ordering API</b>. Everything after that is asynchronous: each status change is an event on <b>RabbitMQ</b> that another component reacts to, and Ordering publishes the new status back. Status path: <code>Submitted</code> (after the grace period) <code>AwaitingValidation</code>, <code>StockConfirmed</code>, <code>Paid</code>. Stock rejection and payment failure lead to <code>Cancelled</code>. WebApp itself only creates and lists orders; shipping and cancelling are the Ordering endpoints <code>PUT /api/orders/ship</code> and <code>/cancel</code>.",
    "actors": [
      "webapp",
      "ordering-api",
      "rabbitmq",
      "basket-api",
      "order-processor",
      "postgres",
      "catalog-api",
      "payment-processor",
      "webhooks-api"
    ],
    "steps": [
      {
        "from": "webapp",
        "to": "ordering-api",
        "kind": "req",
        "label": "Place the order",
        "protocol": "HTTP",
        "call": {
          "verb": "POST",
          "target": "/api/orders"
        },
        "request": {
          "userId": "<buyer id>",
          "userName": "<name>",
          "city": "<city>",
          "street": "<street>",
          "state": "<state>",
          "country": "<country>",
          "zipCode": "<zip>",
          "cardNumber": "<card>",
          "cardTypeId": 1,
          "buyer": "<buyer id>",
          "items": [
            {
              "productId": 1,
              "productName": "<name>",
              "unitPrice": 19.5,
              "quantity": 2
            }
          ],
          "...": "..."
        },
        "requestSchema": {
          "ref": "eShop:src/Ordering.API/Apis/OrdersApi.cs:171",
          "quote": "public record CreateOrderRequest("
        },
        "description": "The <code>x-requestid</code> header carries a GUID that makes the command idempotent. Items are the basket lines enriched with catalog name and price. Field names are shown as sent: ASP.NET Core writes and reads JSON in camelCase, while the record declares them in PascalCase.",
        "evidence": [
          {
            "ref": "eShop:src/WebApp/Services/BasketState.cs:107",
            "quote": "await orderingService.CreateOrder(request, checkoutInfo.RequestId);"
          },
          {
            "ref": "eShop:src/WebApp/Services/OrderingService.cs:15",
            "quote": "requestMessage.Headers.Add(\"x-requestid\""
          },
          {
            "ref": "eShop:src/Ordering.API/Apis/OrdersApi.cs:17",
            "quote": "api.MapPost(\"/\", CreateOrderAsync);"
          }
        ]
      },
      {
        "from": "ordering-api",
        "to": "ordering-api",
        "kind": "self",
        "label": "Create the order as Submitted and queue OrderStarted and Submitted events",
        "noPayload": true,
        "description": "The events are written to an event-log table in the same transaction and published after the transaction commits.",
        "evidence": [
          {
            "ref": "eShop:src/Ordering.API/Application/Commands/CreateOrderCommandHandler.cs:33",
            "quote": "await _orderingIntegrationEventService.AddAndSaveEventAsync(orderStartedIntegrationEvent);"
          },
          {
            "ref": "eShop:src/Ordering.Domain/AggregatesModel/OrderAggregate/Order.cs:57",
            "quote": "OrderStatus = OrderStatus.Submitted;"
          },
          {
            "ref": "eShop:src/Ordering.API/Application/DomainEventHandlers/ValidateOrAddBuyerAggregateWhenOrderStartedDomainEventHandler.cs:51",
            "quote": "await _orderingIntegrationEventService.AddAndSaveEventAsync(integrationEvent);"
          },
          {
            "ref": "eShop:src/Ordering.API/Application/Behaviors/TransactionBehavior.cs:52",
            "quote": "await _orderingIntegrationEventService.PublishEventsThroughEventBusAsync(transactionId);"
          }
        ]
      },
      {
        "from": "webapp",
        "to": "basket-api",
        "kind": "req",
        "label": "Delete the basket after the order call returns",
        "protocol": "gRPC",
        "call": {
          "verb": "rpc",
          "target": "Basket/DeleteBasket"
        },
        "request": {},
        "description": "Ordering commits and publishes its events inside the same request, so the OrderStarted message below can be sent before this call is made; the diagram lists the WebApp call first.",
        "evidence": [
          {
            "ref": "eShop:src/WebApp/Services/BasketState.cs:108",
            "quote": "await DeleteBasketAsync();"
          },
