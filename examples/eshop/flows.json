  {
    "id": "browse-catalogue",
    "title": "Browse the catalogue",
    "tagline": "Storefront to Catalog API and its database",
    "featured": true,
    "summary": "A shopper opens the shop. <b>WebApp</b> asks <b>Catalog API</b> for one page of products (optionally filtered by type and brand), plus the facet counts and the pictures. No events are involved.",
    "actors": [
      "webapp",
      "catalog-api",
      "postgres"
    ],
    "steps": [
      {
        "from": "webapp",
        "to": "catalog-api",
        "kind": "req",
        "label": "Ask for one page of products",
        "protocol": "HTTP",
        "call": {
          "verb": "GET",
          "target": "/api/catalog/items"
        },
        "request": {
          "type": 1,
          "brand": 2,
          "pageIndex": 0,
          "pageSize": 9
        },
        "description": "Query parameters are <code>type</code>, <code>brand</code> (repeatable), <code>pageIndex</code> and <code>pageSize</code>. WebApp asks for API version 2.0.",
        "evidence": [
          {
            "ref": "eShop:src/WebAppComponents/Services/CatalogService.cs:82",
            "quote": "items?{filterQs}pageIndex={pageIndex}&pageSize={pageSize}"
          },
          {
            "ref": "eShop:src/WebApp/Extensions/Extensions.cs:35",
            "quote": ".AddApiVersion(2.0)"
          },
          {
            "ref": "eShop:src/Catalog.API/Apis/CatalogApi.cs:27",
            "quote": "v2.MapGet(\"/items\", GetAllItems)"
          }
        ]
      },
      {
        "from": "catalog-api",
        "to": "postgres",
        "kind": "req",
        "label": "Count and read the page, ordered by name",
        "protocol": "PostgreSQL",
        "payloadNote": "sql",
        "description": "Filters by name, type and brand when given, counts the matches, then reads the requested page ordered by <code>Name</code>.",
        "evidence": [
          {
            "ref": "eShop:src/Catalog.API/Apis/CatalogApi.cs:156",
            "quote": "var totalItems = await root"
          },
          {
            "ref": "eShop:src/Catalog.API/Apis/CatalogApi.cs:161",
            "quote": ".OrderBy(c => c.Name)"
          },
          {
            "ref": "eShop:src/Catalog.API/Apis/CatalogApi.cs:162",
            "quote": ".Skip(pageSize * pageIndex)"
          }
        ]
      },
      {
        "from": "catalog-api",
        "to": "webapp",
        "kind": "res",
        "label": "Return the page",
        "protocol": "HTTP",
        "response": {
          "PageIndex": 0,
          "PageSize": 9,
          "Count": 120,
          "Data": [
            {
              "Id": 1,
              "Name": "<name>",
              "Description": "<text>",
              "Price": 19.5,
              "PictureFileName": "<file>",
              "CatalogTypeId": 1,
              "CatalogBrandId": 2,
              "AvailableStock": 100,
              "...": "..."
            }
          ]
        },
        "responseSchema": {
          "ref": "eShop:src/Catalog.API/Model/PaginatedItems.cs:5",
          "quote": "public class PaginatedItems<TEntity>"
        },
        "description": "Property names are shown as declared in the C# classes. Each item has the fields of <code>CatalogItem</code>; the embedding vector is excluded from JSON.",
        "evidence": [
          {
            "ref": "eShop:src/Catalog.API/Apis/CatalogApi.cs:166",
            "quote": "TypedResults.Ok(new PaginatedItems<CatalogItem>(pageIndex, pageSize, totalItems, itemsOnPage))"
          },
          {
            "ref": "eShop:src/Catalog.API/Model/CatalogItem.cs:39",
            "quote": "[JsonIgnore]"
          }
        ]
      },
      {
        "from": "webapp",
        "to": "catalog-api",
        "kind": "req",
        "label": "Ask for brand and type filter counts",
        "protocol": "HTTP",
        "call": {
          "verb": "GET",
          "target": "/api/catalog/items/facets"
        },
        "payloadNote": "no-body",
        "description": "Returns per-brand and per-type item counts for the current filter selection.",
        "evidence": [
          {
            "ref": "eShop:src/WebAppComponents/Services/CatalogService.cs:64",
            "quote": "items/facets?{filterQs}"
          },
          {
            "ref": "eShop:src/Catalog.API/Apis/CatalogApi.cs:53",
            "quote": "api.MapGet(\"/items/facets\", GetCatalogFacets)"
          }
        ]
      },
      {
        "from": "webapp",
        "to": "catalog-api",
        "kind": "req",
        "label": "Fetch a product picture",
        "protocol": "HTTP",
        "call": {
          "verb": "GET",
          "target": "/api/catalog/items/{id}/pic"
        },
        "payloadNote": "no-body",
        "description": "WebApp forwards <code>/product-images/{id}</code> to Catalog's picture route.",
        "evidence": [
          {
            "ref": "eShop:src/WebApp/Program.cs:32",
            "quote": "app.MapForwarder(\"/product-images/{id}\", \"https+http://catalog-api\""
          },
          {
            "ref": "eShop:src/Catalog.API/Apis/CatalogApi.cs:47",
            "quote": "api.MapGet(\"/items/{id:int}/pic\", GetItemPictureById)"
          }
        ]
      }
    ]
  },
